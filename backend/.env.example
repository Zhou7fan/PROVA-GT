# API keys used by the PROVA-GT backend services.
# Copy this file to .env in the backend directory and fill in your own keys.
# Never commit .env to version control.

# DeepSeek (used by app_ai_chat.py, file_ds.py)
DEEPSEEK_API_KEY=

# Moonshot Kimi (used by file.py, app_memo.py, file_cache.py, overview_la2.py, app_ai_chat_kimi.py)
MOONSHOT_API_KEY=

# Alibaba Cloud DashScope, OpenAI-compatible endpoint (used by app_api.py, overview_api.py)
DASHSCOPE_API_KEY=

# SiliconFlow (used by file_sf.py)
SILICONFLOW_API_KEY=
